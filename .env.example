# ===== LikeChat — pengaturan API =====
# Ganti nilai di bawah ini dengan milikmu. Jangan bagikan file ini ke siapa pun.

# --- Text2text (OpenAI-compatible) ---
# CARA BARU (disarankan): kelompokkan per provider biar mudah dipahami & diganti.
#   baseurl_<provider>    = base URL provider (hcnsec punya bawaan bila dikosongkan)
#   apikey_<provider>_<n> = API key ke-n (1..9), failover berurutan
#   model_<provider>_<n>  = Label:id  (label tampil di pilihan model)
# Urutan di pemilih model: hcnsec dulu, lalu provider lain alfabetis.
# Contoh:
#   baseurl_vyce=https://vyceai.com/v1
#   apikey_vyce_1=key-vyce-pertama
#   apikey_vyce_2=key-vyce-kedua
#   model_vyce_1=sr.lite.0.1-flash:gpt-6-luna
#   model_vyce_2=sr.codex-v.0.2:claude-sonnet-4-6
#   apikey_hcnsec_1=key-hcnsec-pertama
#   model_hcnsec_1=sr.0.1-turtle:glm-5.3-flash
#
# CARA LAMA (tetap jalan bila tidak ada model_* di atas):
TEXT_BASE_URL=https://api.hcnsec.cn/v1
TEXT_API_KEY_1=
TEXT_API_KEY_2=
TEXT_API_KEY_3=
TEXT_API_KEY_4=
TEXT_API_KEY_5=
# Format: Label:id  (label tampil di pilihan model)
TEXT_MODEL_1=sr.flash.0.1:glm-5.3-flash
TEXT_MODEL_2=sr.swift.0.1:space-bunny-free
TEXT_MODEL_3=sr.codex.0.1:DeepSeek-V4-Pro
TEXT_MODEL_4=sr.smart.0.1:kimi-k3
TEXT_MODEL_5=sr.prime.0.1:step-5-preview
# Tambah model/provider baru: pakai nomor berikut yang kosong (8).
# Cara GAMPANG (provider ditulis sekali, dipakai ramai-ramai):
#   VYCE_BASE_URL=https://vyceai.com/v1
#   VYCE_API_KEY_1=key-pertama
#   VYCE_API_KEY_2=key-kedua
#   TEXT_MODEL_6=Labelbebas:nama-model@vyce
# Cara lama (khusus 1 model saja) tetap bisa:
#   TEXT_MODEL_6_BASE_URL=https://...
#   TEXT_MODEL_6_API_KEY_1=...
# 0-2, default 1. Jika model menolak nilai ini, server otomatis coba dengan 1.
TEXT_TEMPERATURE=1
# Batas tunggu respons pertama API (detik). Kalau key menggantung, cepat pindah ke key berikut.
TEXT_FIRST_BYTE_TIMEOUT=60
# Identitas AI: system prompt yang disuntik ke setiap chat. Kosongkan =
# otomatis: AI mengaku sesuai nama versi modelnya (mis. likechat-flash-1.0).
# Isi manual untuk memaksa satu identitas untuk semua model.
# Contoh: SYSTEM_PROMPT=Kamu adalah LikeChat AI versi 2.0, asisten aplikasi LikeChat.
SYSTEM_PROMPT=
# Pencarian web otomatis: 1 = AI otomatis mencari di internet bila pertanyaan
# butuh info terkini (gratis, tanpa API key). 0 = matikan.
WEB_SEARCH=1
# Jumlah hasil pencarian yang diselipkan ke AI (1-10).
WEB_SEARCH_MAX_RESULTS=5

# --- Text2img (OpenAI-compatible) ---
IMAGE_GEN_URL=https://api.deapi.ai/api/v2/images/generations
IMAGE_API_KEY_1=
IMAGE_API_KEY_2=
IMAGE_API_KEY_3=
IMAGE_MODEL=Flux_2_Klein_4B_BF16
# Nama brand model gambar yang diakui AI ke pengguna (default: sr.canvas.0.1).
# ID asli di IMAGE_MODEL jangan diubah (itu nama teknis provider).
IMAGE_MODEL_LABEL=sr.canvas.0.1
IMAGE_WIDTH=768
IMAGE_HEIGHT=1360
IMAGE_SEED=2279401600
IMAGE_STEPS=4

# --- Img2img (OpenAI-compatible) ---
IMAGE_EDIT_URL=https://api.deapi.ai/api/v2/images/edits
